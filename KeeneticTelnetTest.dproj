  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="KeeneticTelnetTest.dpr">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="MainForm.pas">
      <Form>frmMain</Form>
